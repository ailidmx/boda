rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any authenticated user whose auth UID matches an existing guest document
    // (in `guests/{auth.uid}`) is an invited guest and may submit the RSVP,
    // experience, coast, and petanque forms. Auth UIDs are set to the guest ID
    // (from the Google Sheet `ID` column), so this reliably links the auth
    // account to a real guest record.
    function isInvitedGuest() {
      return request.auth != null
        && exists(/databases/$(database)/documents/guests/$(request.auth.uid));
    }

    // An administrator is any authenticated user whose own guest document in
    // `guests/{auth.uid}` has `isAdmin == true`. The `isAdmin` field is
    // sheet-synced (read-only from the client) and is used to grant back-office
    // (dashboard) access. This is data-driven: promoting/demoting an admin is
    // done by editing the sheet and re-syncing, not by editing the rules.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/guests/$(request.auth.uid)).data.keys().hasAny(["isAdmin"])
        && get(/databases/$(database)/documents/guests/$(request.auth.uid)).data.isAdmin == true;
    }





    function hasSubmissionMetadata(version) {
      return request.resource.data.schemaVersion == version
        && request.resource.data.language in ["es", "fr", "en"]
        && request.resource.data.createdAt == request.time;
    }

    function isShortText(field, maximum) {
      return field is string && field.size() <= maximum;
    }

    function hasValidInvitationCode() {
      return !request.resource.data.keys().hasAny(["invitationCode"])
        || request.resource.data.invitationCode in [
          "hortencia_privada_pagada",
          "cabaña_33_privada_porpagar",
          "azalea_compartida_porpagar",
          "sin_cabaña",
          "cabaña_5_privada_porpagar",
          "cabaña_34_privada_pagada",
          "cabaña_4_compartida_pagada",
          "lavanda_compartida_porpagar",
          "casona_compartida_pagada",
          "margarita_compartida_porpagar",
          "cabaña_6_privada_porpagar",
          "dalia_compartida_porpagar",
          "cabaña_31_privada_porpagar",
          "cabaña_32_privada_porpagar"
        ];
    }

    function hasValidRsvpFields() {
      return request.resource.data.keys().hasAll([
          "firstName", "lastName", "email", "whatsapp", "attendance",
          "groupMode", "groupName", "partySize", "adults", "children",
          "guests", "accommodation", "travelStatus", "arrivalFrom",
          "arrivalTo", "arrivalDate", "arrivalTime", "arrivalAirline",
          "arrivalFlight", "departureFrom", "departureTo", "departureDate",
          "departureTime", "departureAirline", "departureFlight", "route",
          "notes", "language", "schemaVersion", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "firstName", "lastName", "email", "whatsapp", "attendance",
          "groupMode", "groupName", "partySize", "adults", "children",
          "guests", "accommodation", "independentArrival", "sundayMorning",
          "travelStatus", "arrivalFrom", "arrivalTo", "arrivalDate",
          "arrivalTime", "arrivalAirline", "arrivalFlight", "departureFrom",
          "departureTo", "departureDate", "departureTime",
          "departureAirline", "departureFlight", "route", "notes",
          "invitationCode", "language", "schemaVersion", "createdAt"
        ])
        && isShortText(request.resource.data.firstName, 100)
        && request.resource.data.firstName.size() > 0
        && isShortText(request.resource.data.lastName, 100)
        && request.resource.data.lastName.size() > 0
        && isShortText(request.resource.data.email, 254)
        && request.resource.data.email.size() > 0
        && isShortText(request.resource.data.whatsapp, 50)
        && request.resource.data.whatsapp.size() > 0
        && isShortText(request.resource.data.attendance, 30)
        && isShortText(request.resource.data.groupMode, 30)
        && isShortText(request.resource.data.groupName, 150)
        && isShortText(request.resource.data.partySize, 2)
        && isShortText(request.resource.data.adults, 2)
        && isShortText(request.resource.data.children, 2)
        && isShortText(request.resource.data.guests, 1000)
        && isShortText(request.resource.data.accommodation, 30)
        && (!request.resource.data.keys().hasAny(["independentArrival"])
          || isShortText(request.resource.data.independentArrival, 30))
        && (!request.resource.data.keys().hasAny(["sundayMorning"])
          || isShortText(request.resource.data.sundayMorning, 30))
        && isShortText(request.resource.data.travelStatus, 30)
        && isShortText(request.resource.data.arrivalFrom, 150)
        && isShortText(request.resource.data.arrivalTo, 150)
        && isShortText(request.resource.data.arrivalDate, 10)
        && isShortText(request.resource.data.arrivalTime, 5)
        && isShortText(request.resource.data.arrivalAirline, 100)
        && isShortText(request.resource.data.arrivalFlight, 30)
        && isShortText(request.resource.data.departureFrom, 150)
        && isShortText(request.resource.data.departureTo, 150)
        && isShortText(request.resource.data.departureDate, 10)
        && isShortText(request.resource.data.departureTime, 5)
        && isShortText(request.resource.data.departureAirline, 100)
        && isShortText(request.resource.data.departureFlight, 30)
        && isShortText(request.resource.data.route, 500)
        && isShortText(request.resource.data.notes, 2000);
    }

    match /rsvp_submissions/{submissionId} {
      allow create: if isInvitedGuest()
        && hasSubmissionMetadata(3)
        && hasValidInvitationCode()
        && hasValidRsvpFields();
      // RSVP submissions contain personal data (names, emails, phones,
      // travel itineraries). Only administrators (back office) may read them.
      allow read: if isAdmin();
      allow update, delete: if false;
    }


    match /experience_suggestions/{submissionId} {
      allow create: if isInvitedGuest()
        && hasSubmissionMetadata(1)
        && request.resource.data.keys().hasOnly([
          "name", "dessert", "foodSuggestion", "songTitle", "songArtist",
          "singInterest", "extra", "invitationCode", "language",
          "schemaVersion", "createdAt"
        ])
        && hasValidInvitationCode()
        && isShortText(request.resource.data.name, 150)
        && request.resource.data.name.size() > 0
        && isShortText(request.resource.data.dessert, 50)
        && isShortText(request.resource.data.foodSuggestion, 2000)
        && isShortText(request.resource.data.songTitle, 300)
        && isShortText(request.resource.data.songArtist, 300)
        && isShortText(request.resource.data.singInterest, 50)
        && isShortText(request.resource.data.extra, 2000);
      // Only administrators (back office) may read submissions.
      allow read: if isAdmin();
      allow update, delete: if false;
    }


    match /coast_interest/{submissionId} {
      allow create: if isInvitedGuest()
        && hasSubmissionMetadata(1)
        && request.resource.data.keys().hasOnly([
          "name", "interest", "partySize", "nights", "destination", "style",
          "note", "invitationCode", "language", "schemaVersion", "createdAt"
        ])
        && hasValidInvitationCode()
        && isShortText(request.resource.data.name, 150)
        && request.resource.data.name.size() > 0
        && isShortText(request.resource.data.interest, 50)
        && isShortText(request.resource.data.partySize, 2)
        && isShortText(request.resource.data.nights, 1)
        && isShortText(request.resource.data.destination, 100)
        && isShortText(request.resource.data.style, 100)
        && isShortText(request.resource.data.note, 2000);
      // Only administrators (back office) may read submissions.
      allow read: if isAdmin();
      allow update, delete: if false;
    }


    match /petanque_participation/{submissionId} {
      allow create: if isInvitedGuest()
        && request.resource.data.keys().hasOnly([
          "petanqueParticipation", "petanquePartySize", "petanqueNames",
          "petanqueOwnBoules", "invitationCode", "language",
          "schemaVersion", "createdAt"
        ])
        && hasValidInvitationCode()
        && isShortText(request.resource.data.petanqueParticipation, 30)
        && isShortText(request.resource.data.petanquePartySize, 2)
        && isShortText(request.resource.data.petanqueNames, 500)
        && isShortText(request.resource.data.petanqueOwnBoules, 30);
      // Only administrators (back office) may read submissions.
      allow read: if isAdmin();
      allow update, delete: if false;
    }


    // Auth UIDs are set to the guest ID (from the Google Sheet `ID` column),
    // so the editor's invitation group is read directly from their own guest
    // document in `guests/{auth.uid}`.
    //
    // The `guests` documents are synced from the Google Sheet, which stores the
    // group under the English field name `invitationGroup`. The client writes
    // the same `invitationGroup` field on save, so we read that one to reliably
    // resolve the editor's group.

    function editorInvitationGroup() {
      return get(/databases/$(database)/documents/guests/$(request.auth.uid)).data.invitationGroup;
    }

    function guestWriteInvitationGroup() {
      return request.resource.data.keys().hasAny(["invitationGroup"])
        ? request.resource.data.invitationGroup
        : (resource == null ? "" : resource.data.invitationGroup);
    }


    // A group member may update the contact details (phone), the
    // identity-check acknowledgement, the avatar photo (Cloudinary ID), and
    // name corrections of any member of their own invitation group on the
    // `guests` collection. Only those fields plus lightweight metadata are
    // allowed.
    //
    // AGREED SCHEMA: English field names only. Names are stored as
    // `firstName`/`lastName` (combined from the sheet's nombre/apellido
    // columns). The message author is `messageAuthor`. No Spanish field names
    // (nombre, apellido, message_author, cabana, cuarto, mesa, etc.) are
    // allowed — those are derived/calculated and live in the sheet, not here.
    //
    // NOTE: `email` is intentionally NOT allowed here. A guest's email is the
    // Firebase Auth login credential and must be changed via `updateEmail` in
    // the SDK — it is never stored in the `guests` collection.
    //
    // SCHEMA ENFORCEMENT: The `hasOnly()` list below includes ALL fields that
    // exist in the `guests` documents (both sheet-synced read-only fields and
    // client-writable fields). This prevents clients from creating NEW fields
    // that aren't part of the agreed schema. The `affectedKeys().hasOnly()`
    // check further restricts clients to only MODIFY the writable fields —
    // sheet-synced fields (id, lang, age, cabin, room, table, rsvp, etc.)
    // cannot be changed from the client.
    // Shared base validation for `guests` writes. Enforces the agreed schema
    // (hasAll/hasOnly) and field types. The `affectedKeys().hasOnly()` check
    // is intentionally NOT here — it differs between regular guests and
    // administrators (see hasValidGuestContactFields / hasValidAdminGuestFields).
    function hasValidGuestIdentityFields() {
      return (!request.resource.data.keys().hasAny(["identity"])
          || (request.resource.data.identity is map
            && request.resource.data.identity.keys().hasOnly([
              "age", "cloudinaryId", "firstName", "gender", "middleName", "lastName", "maternalLastName", "lang", "phone"
            ])
            && (!request.resource.data.identity.keys().hasAny(["age"])
              || isShortText(request.resource.data.identity.age, 50))
            && (!request.resource.data.identity.keys().hasAny(["firstName"])
              || isShortText(request.resource.data.identity.firstName, 100))
            && (!request.resource.data.identity.keys().hasAny(["middleName"])
              || isShortText(request.resource.data.identity.middleName, 100))
            && (!request.resource.data.identity.keys().hasAny(["lastName"])
              || isShortText(request.resource.data.identity.lastName, 100))
            && (!request.resource.data.identity.keys().hasAny(["maternalLastName"])
              || isShortText(request.resource.data.identity.maternalLastName, 100))
            && (!request.resource.data.identity.keys().hasAny(["gender"])
              || isShortText(request.resource.data.identity.gender, 30))
            && (!request.resource.data.identity.keys().hasAny(["cloudinaryId"])
              || isShortText(request.resource.data.identity.cloudinaryId, 200))
            && (!request.resource.data.identity.keys().hasAny(["lang"])
              || isShortText(request.resource.data.identity.lang, 20))
            && (!request.resource.data.identity.keys().hasAny(["phone"])
              || isShortText(request.resource.data.identity.phone, 50))));
    }

    function hasValidGuestHostingFields() {
      return (!request.resource.data.keys().hasAny(["hosting"])
          || (request.resource.data.hosting is map
            && request.resource.data.hosting.keys().hasOnly([
              "cabin", "room", "xtraCabin", "xtraRoom",
              "isCabinPaidByNovios", "isCabinPaid",
              "isXtraCabinPaidByNovios", "isXtraCabinPaid"
            ])
            && (!request.resource.data.hosting.keys().hasAny(["cabin"])
              || isShortText(request.resource.data.hosting.cabin, 150))
            && (!request.resource.data.hosting.keys().hasAny(["room"])
              || isShortText(request.resource.data.hosting.room, 150))
            && (!request.resource.data.hosting.keys().hasAny(["xtraCabin"])
              || isShortText(request.resource.data.hosting.xtraCabin, 150))
            && (!request.resource.data.hosting.keys().hasAny(["xtraRoom"])
              || isShortText(request.resource.data.hosting.xtraRoom, 150))
            && (!request.resource.data.hosting.keys().hasAny(["isCabinPaidByNovios"])
              || request.resource.data.hosting.isCabinPaidByNovios is bool)
            && (!request.resource.data.hosting.keys().hasAny(["isCabinPaid"])
              || request.resource.data.hosting.isCabinPaid is bool)
            && (!request.resource.data.hosting.keys().hasAny(["isXtraCabinPaidByNovios"])
              || request.resource.data.hosting.isXtraCabinPaidByNovios is bool)
            && (!request.resource.data.hosting.keys().hasAny(["isXtraCabinPaid"])
              || request.resource.data.hosting.isXtraCabinPaid is bool)));
    }

    function hasValidGuestContactFieldsBase() {
      return request.resource.data.keys().hasAll([
          "guestId", "updatedBy", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          // Client-writable fields
          "guestId", "identity",
          "idCheckUser", "cloudinaryId", "messageAuthor",
          "invitationGroup", "updatedBy", "updatedAt", "_deleted",
          // Legacy flat fields kept temporarily during migration
          "firstName", "middleName", "lastName", "maternalLastName", "gender", "cloudinaryId", "lang", "age", "phone",
          "cabin", "room", "xtraCabin", "xtraRoom",
          "isCabinPaidByNovios", "isCabinPaid",
          "isXtraCabinPaidByNovios", "isXtraCabinPaid",
          // Sheet-synced read-only fields (populated by Admin SDK)
          "id", "gender", "tagGroup",
          "hosting", "table", "sent",
          "modifiedAt", "travelsByPlane", "isAdmin",
          "_source", "_migratedAt", "message", "rsvp"
        ])
        && isShortText(request.resource.data.guestId, 100)
        && request.resource.data.guestId.size() > 0
        && (!request.resource.data.keys().hasAny(["invitationGroup"])
          || isShortText(request.resource.data.invitationGroup, 150))
        && isShortText(request.resource.data.updatedBy, 100)

        && request.resource.data.updatedAt == request.time
        && hasValidGuestIdentityFields()
        && hasValidGuestHostingFields()
        && (!request.resource.data.keys().hasAny(["firstName"])
          || isShortText(request.resource.data.firstName, 100))
        && (!request.resource.data.keys().hasAny(["middleName"])
          || isShortText(request.resource.data.middleName, 100))
        && (!request.resource.data.keys().hasAny(["lastName"])
          || isShortText(request.resource.data.lastName, 100))
        && (!request.resource.data.keys().hasAny(["maternalLastName"])
          || isShortText(request.resource.data.maternalLastName, 100))
        && (!request.resource.data.keys().hasAny(["gender"])
          || isShortText(request.resource.data.gender, 30))
        && (!request.resource.data.keys().hasAny(["cloudinaryId"])
          || isShortText(request.resource.data.cloudinaryId, 200))

        && (!request.resource.data.keys().hasAny(["phone"])
          || isShortText(request.resource.data.phone, 50))
        && (!request.resource.data.keys().hasAny(["idCheckUser"])
          || request.resource.data.idCheckUser is bool)
        && (!request.resource.data.keys().hasAny(["cloudinaryId"])
          || (request.resource.data.cloudinaryId is string
            && request.resource.data.cloudinaryId.size() <= 200))
        && (!request.resource.data.keys().hasAny(["messageAuthor"])
          || isShortText(request.resource.data.messageAuthor, 200))
        && (!request.resource.data.keys().hasAny(["_deleted"])
          || request.resource.data._deleted is bool)
        // `rsvp` is static data from the sheet (RVSP_* columns). It is
        // populated by the migration script (Admin SDK) and is read-only
        // from the client. We allow it in hasOnly() so existing documents
        // with `rsvp` can still be updated by clients, but we do NOT allow
        // clients to modify it (it's not in the writable field list above).
        && (!request.resource.data.keys().hasAny(["rsvp"])
          || request.resource.data.rsvp is map);
    }

    // REGULAR GUEST WRITE SCOPE: A group member may update the contact details
    // (phone), the identity-check acknowledgement, the avatar photo (Cloudinary
    // ID), name corrections, and the message author of any member of their own
    // invitation group. `invitationGroup` and `_deleted` are intentionally NOT
    // in the affectedKeys list: changing group membership or soft-deleting a
    // guest is an administrative operation (see hasValidAdminGuestFields).
    function hasValidGuestContactFields() {
      return hasValidGuestContactFieldsBase()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestId", "identity",
          "idCheckUser", "cloudinaryId", "messageAuthor",
          // Legacy flat identity writes allowed only during transition.
          "firstName", "middleName", "lastName", "maternalLastName", "gender", "cloudinaryId", "lang", "age", "phone",
          "updatedBy", "updatedAt"
        ]);
    }


    // ADMIN WRITE SCOPE: Administrators may additionally modify `invitationGroup`
    // (reassign a guest to a different invitation group) and `_deleted`
    // (soft-delete a guest). These are privileged operations that regular
    // guests must never perform. All other field restrictions from
    // hasValidGuestContactFieldsBase() still apply.
    function hasValidAdminGuestFields() {
      return hasValidGuestContactFieldsBase()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestId", "identity",
          "idCheckUser", "cloudinaryId", "messageAuthor",
          "firstName", "middleName", "lastName", "maternalLastName", "gender", "cloudinaryId", "lang", "age", "phone",
          "invitationGroup", "updatedBy", "updatedAt", "_deleted"
        ]);
    }

    // Metadata-only guest touch. Any authenticated user may refresh
    // `updatedBy`/`updatedAt` on an existing guest document without changing
    // group-scoped or identity fields.
    function hasValidGuestAuditTouch() {
      return resource != null
        && request.resource.data.keys().hasAll(["guestId", "updatedBy", "updatedAt"])
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "updatedBy", "updatedAt"
        ])
        && isShortText(request.resource.data.updatedBy, 100)
        && request.resource.data.updatedAt == request.time;
    }



    // ── Save-the-date attendance responses ────────────────────────────────

    // Each guest may indicate, for each member of their invitation group,
    // whether they plan to join on Friday, Saturday and Sunday. Responses are
    // stored per guest under `attendance_responses/{guestId}`.
    function hasValidAttendanceFields() {
      return request.resource.data.keys().hasAll([
          "guestId", "friday", "saturday", "sunday", "invitationGroup",
          "updatedBy", "language", "schemaVersion", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "guestId", "friday", "saturday", "sunday", "invitationGroup",
          "updatedBy", "language", "schemaVersion", "updatedAt"
        ])
        && isShortText(request.resource.data.guestId, 100)
        && request.resource.data.guestId.size() > 0
        && request.resource.data.friday in ["yes", "no", "maybe", ""]
        && request.resource.data.saturday in ["yes", "no", "maybe", ""]
        && request.resource.data.sunday in ["yes", "no", "maybe", ""]
        && isShortText(request.resource.data.invitationGroup, 150)
        && isShortText(request.resource.data.updatedBy, 100)
        && request.resource.data.language in ["es", "fr", "en"]
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time;
    }

    match /attendance_responses/{guestId} {
      // Attendance responses are personal data. Only administrators (back
      // office) may read the whole collection. Guests read only their own
      // group's responses via a query filtered by `invitationGroup`.
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.invitationGroup == editorInvitationGroup());
      allow create, update: if request.auth != null
        && hasValidAttendanceFields()
        && editorInvitationGroup() == request.resource.data.invitationGroup;
      allow delete: if false;
    }



    match /guests/{guestId} {

      // READ SCOPE: Administrators may read any guest. A regular authenticated
      // guest may only read members of their OWN invitation group (resolved
      // from `guests/{auth.uid}.invitationGroup`). This prevents a guest from
      // seeing other groups' phone, cabin, room, table, payment, and admin
      // data. The rule is query-compatible: a list query MUST filter by
      // `where('invitationGroup', '==', <myGroup>)` for it to succeed.
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.invitationGroup == editorInvitationGroup());
      // AGREED SCHEMA ENFORCEMENT: ALL writes must pass the schema validation.
      // Administrators use hasValidAdminGuestFields() (may additionally modify
      // `invitationGroup` and `_deleted`); regular guests use
      // hasValidGuestContactFields() (may NOT modify `invitationGroup` or
      // `_deleted`). Administrators may write to any guest; regular guests may
      // only write to members of their own invitation group.
      allow create, update: if request.auth != null
        && (
          (
            (isAdmin()
              ? hasValidAdminGuestFields()
              : hasValidGuestContactFields())
            && (isAdmin() || editorInvitationGroup() == guestWriteInvitationGroup())
          )
          || hasValidGuestAuditTouch()
        );

      allow delete: if isAdmin();

    }





    // ── Invitation groups ──────────────────────────────────────────────────
    // Group content (customContent, tag styling) is personalized per group.
    // A guest may only read their OWN group's content. Administrators may
    // read all groups (for the dashboard). The document ID IS the group
    // name (e.g. "Familia de David"), so we compare the document ID to the
    // editor's invitation group.
    //
    // SCHEMA: Documents contain exactly two top-level fields:
    //   tag: { color: string, textColor: string, label: string }
    //   customContent: { greeting: string, message: string, section: string,
    //                    hideSections: string[] }
    // Admin writes are validated against this schema to prevent arbitrary
    // field creation or oversized content.
    function hasValidInvitationGroupFields() {
      return request.resource.data.keys().hasOnly(["tag", "customContent"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tag", "customContent"])
        && (!request.resource.data.keys().hasAny(["tag"])
          || (request.resource.data.tag is map
            && request.resource.data.tag.keys().hasOnly(["color", "textColor", "label"])
            && isShortText(request.resource.data.tag.color, 20)
            && isShortText(request.resource.data.tag.textColor, 20)
            && isShortText(request.resource.data.tag.label, 200)))
        && (!request.resource.data.keys().hasAny(["customContent"])
          || (request.resource.data.customContent is map
            && request.resource.data.customContent.keys().hasOnly(["greeting", "message", "section", "hideSections"])
            && (!request.resource.data.customContent.keys().hasAny(["greeting"])
              || isShortText(request.resource.data.customContent.greeting, 2000))
            && (!request.resource.data.customContent.keys().hasAny(["message"])
              || isShortText(request.resource.data.customContent.message, 5000))
            && (!request.resource.data.customContent.keys().hasAny(["section"])
              || isShortText(request.resource.data.customContent.section, 5000))
            && (!request.resource.data.customContent.keys().hasAny(["hideSections"])
              || (request.resource.data.customContent.hideSections is list
                && request.resource.data.customContent.hideSections.size() <= 20))));

    }

    match /invitation_groups/{groupId} {
      allow read: if isAdmin()
        || (request.auth != null
            && groupId == editorInvitationGroup());
      allow create, update: if isAdmin() && hasValidInvitationGroupFields();
      allow delete: if isAdmin();
    }



    // ── Rooms ───────────────────────────────────────────────────────────────
    // Room inventory (id, cabin, description {es,fr,en}, capacity, isShared).
    // Readable by everyone; writable only by the couple. The schema is
    // enforced with hasOnly() so no extra fields can be added from the client.
    function hasValidRoomFields() {
      return request.resource.data.keys().hasAll([
          "id", "cabin", "description", "capacity", "isShared"
        ])
        && request.resource.data.keys().hasOnly([
          "id", "cabin", "description", "capacity", "isShared"
        ])
        && isShortText(request.resource.data.id, 100)
        && request.resource.data.id.size() > 0
        && isShortText(request.resource.data.cabin, 100)
        && request.resource.data.cabin.size() > 0
        && request.resource.data.description is map
        && request.resource.data.description.keys().hasOnly(["es", "fr", "en"])
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.isShared is bool;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidRoomFields();
      allow delete: if isAdmin();
    }




    // ── Thanks / greetings ──────────────────────────────────────────────────
    // Sourced from the Google Sheet THANKS table (guest -> text in fr/es/en).
    // One document per credit record; a guest may appear in many records.
    // Readable by everyone, writable only by administrators.
    //
    // SCHEMA: { guest: string, fr: string, es: string, en: string,
    //           _source?: string, _migratedAt?: string }
    // Admin writes are validated against this schema to prevent arbitrary
    // field creation or oversized content.
    function hasValidThanksFields() {
      return request.resource.data.keys().hasOnly([
          "guest", "fr", "es", "en", "_source", "_migratedAt"
        ])
        && isShortText(request.resource.data.guest, 100)
        && request.resource.data.guest.size() > 0
        && isShortText(request.resource.data.fr, 2000)
        && isShortText(request.resource.data.es, 2000)
        && isShortText(request.resource.data.en, 2000)
        && (!request.resource.data.keys().hasAny(["_source"])
          || isShortText(request.resource.data._source, 100))
        && (!request.resource.data.keys().hasAny(["_migratedAt"])
          || isShortText(request.resource.data._migratedAt, 100));
    }

    match /thanks/{creditId} {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidThanksFields();
      allow delete: if isAdmin();
    }



    // ── Default deny ────────────────────────────────────────────────────────
    // Any collection not explicitly listed above is DENIED by default. This is
    // the safe baseline: new collections must be explicitly granted access in
    // this file before clients can read or write them. This prevents accidental
    // public exposure of future collections.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
