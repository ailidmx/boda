{
  "name": "boda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:all": "node scripts/build-all.mjs",
    "dev:invitation": "npm --prefix web/invitation run dev",
    "dev:dashboard": "npm --prefix web/dashboard run dev",
    "lint": "eslint .",
    "sync:gsheet:report": "node scripts/gsheet-firestore-sync.mjs --ci --report-json=reports/gsheet-firestore-sync-report.json --report-md=reports/gsheet-firestore-sync-report.md",
    "sync:gsheet:execute": "node scripts/gsheet-firestore-sync.mjs --execute --report-json=reports/gsheet-firestore-sync-report.json --report-md=reports/gsheet-firestore-sync-report.md",
    "test": "npm --prefix web/invitation run test:validation && npm --prefix web/invitation run test:analytics && npm --prefix web/invitation run test:button && npm --prefix web/invitation run test:guest-profiles",



    "test:rules": "cd web/invitation && firebase emulators:exec --only firestore 'node --test tests/firestore.rules.test.mjs'"

  },

  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0"
  }
}
